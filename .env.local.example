# Variables d'environnement exemples (à copier dans `.env.local` en production)

# Informations administratives
NEXT_PUBLIC_SIRET=En_cours_d_immatriculation
NEXT_PUBLIC_RNA=En_cours_d_obtention
NEXT_PUBLIC_ACACED=En_cours_d_obtention
NEXT_PUBLIC_ICAD_HABILITATION=En_cours_d_habilitation

# URL du site
NEXT_PUBLIC_SITE_URL=https://afm-affm.vercel.app

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Assistant chat (xAI / Grok)
XAI_API_KEY=
CHAT_API_KEY=
CHAT_API_URL=https://api.x.ai/v1/chat/completions
CHAT_MODEL=grok-4.7

# Ne pas préfixer les clés privées par NEXT_PUBLIC_. Gardez ces valeurs côté serveur.
