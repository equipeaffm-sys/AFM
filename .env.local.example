# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
# Paiements désactivés par défaut. Laisser PAYMENTS_ENABLED=false jusqu'à validation
# complète des règles de livraison/fiscalité et des tests Stripe.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Les pays autorisés et les tarifs de livraison ne sont plus définis ici : ils sont
# administrés par zone (France / Europe / International) dans Supabase
# (tables shipping_zones et tax_rates). Aucune variable d'environnement de tarif
# n'est nécessaire. Les anciennes variables STRIPE_ALLOWED_COUNTRIES et
# STRIPE_SHIPPING_RATE_ID ne sont plus utilisées par le checkout.

# Resend order emails (server-only; use a sender address verified in Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# xAI Grok Chat Configuration (server-only; never use NEXT_PUBLIC_ for these values)
XAI_API_KEY=
CHAT_API_URL=https://api.x.ai/v1/chat/completions
CHAT_MODEL=grok-4.7

# Public site URL used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
