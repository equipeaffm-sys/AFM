# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Groq AI Chat Configuration (server-only; never use NEXT_PUBLIC_ for these values)
# Use the Groq key with the CHAT_API_KEY variable name
CHAT_API_KEY=
CHAT_API_URL=https://api.groq.com/openai/v1/chat/completions
CHAT_MODEL=llama-3.3-70b-versatile

# Public site URL used for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
